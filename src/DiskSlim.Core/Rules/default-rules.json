{
  // DiskSlim 默认清理规则
  //
  // paths      路径模板：支持环境变量（%LOCALAPPDATA%）和通配符（* ?，可出现在任意一级），用 / 或 \\ 分隔均可；
  //            ::RecycleBin 表示回收站。
  // risk       low    = 可放心清理（缓存、临时文件，删除后会自动重建）
  //            medium = 需要确认（删除后要重新下载，或需要用户判断）
  //            high   = 仅供参考（用户数据或系统文件，不建议用工具清理）
  // action     工具怎么清理（不写 = none）：
  //            none              = 工具不清理，只给建议
  //            delete            = 永久删除其中的文件（目录本身保留），适合缓存和临时文件
  //            recycle           = 把文件移到回收站，适合用户文件
  //            quarantine        = 移入 DiskSlim 的隔离区，可以随时恢复，适合“需要确认”的内容
  //            empty-recycle-bin = 清空回收站
  //            purge-quarantine  = 彻底删除隔离区中超过 minAgeDays 天的内容
  //            risk 为 high 的规则不能设置 action。
  // minAgeDays 只把 N 天前修改（或创建）过的文件计为“可释放”，清理时也只删这些文件。
  // processes  这些程序运行时跳过这条规则（不带 .exe）。
  //
  // 同一个路径只算给第一条命中它的规则：具体的规则放前面，宽泛的规则放后面。
  "version": 1,
  "rules": [
    // ───────────── DiskSlim 自己的隔离区 ─────────────
    {
      "id": "quarantine-expired",
      "name": "隔离区中超过 7 天的内容",
      "action": "purge-quarantine",
      "category": "DiskSlim",
      "paths": ["::Quarantine"],
      "risk": "low",
      "minAgeDays": 7,
      "advice": "之前清理时移入隔离区的文件，已经放了 7 天以上，一般可以彻底删除了。想先看看或恢复：diskslim quarantine。"
    },

    // ───────────── 系统临时文件 ─────────────
    {
      "id": "user-temp",
      "name": "用户临时文件",
      "action": "delete",
      "category": "系统",
      "paths": ["%TEMP%"],
      "risk": "low",
      "minAgeDays": 1,
      "advice": "设置 → 系统 → 存储 → 临时文件。只把 1 天前的文件计为可释放，正在使用的文件清理时会被自动跳过。"
    },
    {
      "id": "windows-temp",
      "name": "Windows 临时文件",
      "action": "delete",
      "category": "系统",
      "paths": ["%SystemRoot%/Temp"],
      "risk": "low",
      "minAgeDays": 1,
      "advice": "需要管理员权限才能完整统计。用“磁盘清理 → 清理系统文件 → 临时文件”清理。"
    },
    {
      "id": "windows-update-cache",
      "name": "Windows 更新下载缓存",
      "category": "系统",
      "paths": ["%SystemRoot%/SoftwareDistribution/Download"],
      "risk": "low",
      "advice": "运行 diskslim system run windows-update-cache（需要管理员权限），或用“磁盘清理 → 清理系统文件 → Windows 更新清理”。系统正在下载或安装更新时不要清理。"
    },
    {
      "id": "delivery-optimization",
      "name": "传递优化缓存",
      "category": "系统",
      "paths": ["%SystemRoot%/ServiceProfiles/NetworkService/AppData/Local/Microsoft/Windows/DeliveryOptimization/Cache"],
      "risk": "low",
      "advice": "需要管理员权限才能统计。运行 diskslim system run delivery-optimization，或用“磁盘清理 → 传递优化文件”清理。"
    },
    {
      "id": "error-reports",
      "name": "错误报告和崩溃转储",
      "action": "delete",
      "category": "系统",
      "paths": [
        "%LOCALAPPDATA%/CrashDumps",
        "%LOCALAPPDATA%/Microsoft/Windows/WER",
        "%ProgramData%/Microsoft/Windows/WER",
        "%SystemRoot%/Minidump",
        "%SystemRoot%/MEMORY.DMP",
        "%SystemRoot%/LiveKernelReports"
      ],
      "risk": "low",
      "advice": "只有排查蓝屏或程序崩溃时才需要保留。用“磁盘清理 → 系统错误内存转储文件 / Windows 错误报告”清理。"
    },
    {
      "id": "thumbnail-cache",
      "name": "缩略图和图标缓存",
      "category": "系统",
      "paths": [
        "%LOCALAPPDATA%/Microsoft/Windows/Explorer/thumbcache_*.db",
        "%LOCALAPPDATA%/Microsoft/Windows/Explorer/iconcache_*.db"
      ],
      "risk": "low",
      "advice": "用“磁盘清理 → 缩略图”清理，删除后会自动重建。"
    },
    {
      "id": "shader-cache",
      "name": "显卡着色器缓存",
      "action": "delete",
      "category": "系统",
      "paths": [
        "%LOCALAPPDATA%/D3DSCache",
        "%LOCALAPPDATA%/NVIDIA/DXCache",
        "%LOCALAPPDATA%/NVIDIA/GLCache",
        "%LOCALAPPDATA%/AMD/DxCache",
        "%LOCALAPPDATA%/AMD/DxcCache",
        "%LOCALAPPDATA%/AMD/VkCache"
      ],
      "risk": "low",
      "minAgeDays": 1,
      "advice": "显卡驱动编译好的着色器。删除后游戏第一次启动或进入新场景时会稍慢，之后自动重建；正在运行的游戏占用的文件会被自动跳过。也可以用“磁盘清理 → DirectX 着色器缓存”。"
    },
    {
      "id": "squirrel-temp",
      "name": "软件安装程序的临时文件",
      "action": "delete",
      "category": "系统",
      "paths": ["%LOCALAPPDATA%/SquirrelTemp"],
      "risk": "low",
      "minAgeDays": 1,
      "advice": "Discord、Teams 等软件的安装程序（Squirrel）解压用的临时文件夹，装完就用不到了。只清理 1 天前的，正在安装的软件不受影响。"
    },
    {
      "id": "nvidia-driver-installers",
      "name": "NVIDIA 驱动安装包",
      "action": "quarantine",
      "category": "系统",
      "paths": [
        "%ProgramData%/NVIDIA Corporation/Downloader/????????????????????????????????",
        "%ProgramData%/NVIDIA Corporation/Downloader/latest",
        "%ProgramData%/NVIDIA Corporation/NVIDIA app/UpdateFramework/ota-artifacts/grd",
        "%ProgramData%/NVIDIA Corporation/NVIDIA app/UpdateFramework/ota-artifacts/crd"
      ],
      "risk": "medium",
      "minAgeDays": 3,
      "processes": ["NVIDIA app", "NVIDIA GeForce Experience"],
      "advice": "NVIDIA App / GeForce Experience 下载的显卡驱动安装包和解压出来的文件，每更新一次驱动就多攒一份（每份 1～4 GB）。驱动装好后就用不到了，删除不影响已经安装的驱动；以后要重装驱动时 NVIDIA App 会重新下载。只处理 3 天前的，正在下载的驱动不受影响。"
    },

    // ───────────── 浏览器 ─────────────
    {
      "id": "chrome-cache",
      "name": "Chrome 缓存",
      "action": "delete",
      "category": "浏览器",
      "paths": [
        "%LOCALAPPDATA%/Google/Chrome/User Data/*/Cache",
        "%LOCALAPPDATA%/Google/Chrome/User Data/*/Code Cache",
        "%LOCALAPPDATA%/Google/Chrome/User Data/*/GPUCache"
      ],
      "risk": "low",
      "processes": ["chrome"],
      "advice": "Chrome 设置 → 隐私和安全 → 删除浏览数据，只勾选“缓存的图片和文件”，不会退出登录。"
    },
    {
      "id": "edge-cache",
      "name": "Edge 缓存",
      "action": "delete",
      "category": "浏览器",
      "paths": [
        "%LOCALAPPDATA%/Microsoft/Edge/User Data/*/Cache",
        "%LOCALAPPDATA%/Microsoft/Edge/User Data/*/Code Cache",
        "%LOCALAPPDATA%/Microsoft/Edge/User Data/*/GPUCache"
      ],
      "risk": "low",
      "processes": ["msedge"],
      "advice": "Edge 设置 → 隐私、搜索和服务 → 清除浏览数据，只勾选“缓存的图像和文件”，不会退出登录。"
    },
    {
      "id": "firefox-cache",
      "name": "Firefox 缓存",
      "action": "delete",
      "category": "浏览器",
      "paths": ["%LOCALAPPDATA%/Mozilla/Firefox/Profiles/*/cache2"],
      "risk": "low",
      "processes": ["firefox"],
      "advice": "Firefox 设置 → 隐私与安全 → Cookie 和网站数据 → 清除数据，只勾选“缓存的 Web 内容”。"
    },
    {
      "id": "360-browser-cache",
      "name": "360 浏览器缓存",
      "action": "delete",
      "category": "浏览器",
      "paths": [
        "%LOCALAPPDATA%/360Chrome/Chrome/User Data/*/Cache",
        "%LOCALAPPDATA%/360Chrome/Chrome/User Data/*/Code Cache",
        "%LOCALAPPDATA%/360Chrome/Chrome/User Data/*/GPUCache",
        "%LOCALAPPDATA%/360ChromeX/Chrome/User Data/*/Cache",
        "%LOCALAPPDATA%/360ChromeX/Chrome/User Data/*/Code Cache",
        "%LOCALAPPDATA%/360ChromeX/Chrome/User Data/*/GPUCache",
        "%APPDATA%/360se6/User Data/*/Cache",
        "%APPDATA%/360se6/User Data/*/Code Cache",
        "%APPDATA%/360se6/User Data/*/GPUCache"
      ],
      "risk": "low",
      "processes": ["360chrome", "360ChromeX", "360se"],
      "advice": "360 极速浏览器和 360 安全浏览器的网页缓存。也可以在浏览器的“清除上网痕迹”里只勾选缓存，不会退出登录。"
    },
    {
      "id": "qq-browser-cache",
      "name": "QQ 浏览器缓存",
      "action": "delete",
      "category": "浏览器",
      "paths": [
        "%LOCALAPPDATA%/Tencent/QQBrowser/User Data/*/Cache",
        "%LOCALAPPDATA%/Tencent/QQBrowser/User Data/*/Code Cache",
        "%LOCALAPPDATA%/Tencent/QQBrowser/User Data/*/GPUCache"
      ],
      "risk": "low",
      "processes": ["QQBrowser"],
      "advice": "QQ 浏览器的网页缓存。也可以在浏览器的“清除浏览数据”里只勾选缓存，不会退出登录。"
    },
    {
      "id": "google-updater-cache",
      "name": "Google 更新程序缓存的安装包",
      "category": "浏览器",
      "paths": [
        "%ProgramFiles(x86)%/Google/GoogleUpdater/crx_cache",
        "%ProgramFiles%/Google/GoogleUpdater/crx_cache",
        "%LOCALAPPDATA%/Google/GoogleUpdater/crx_cache"
      ],
      "risk": "medium",
      "advice": "Google 更新程序下载的 Chrome 安装包，Chrome 升级后一般会被新版本替换。它在 Program Files 里，工具不会清理；需要时可以以管理员身份手动删除 crx_cache 里的文件，Chrome 下次更新时会重新下载。"
    },

    // ───────────── 常用软件 ─────────────
    {
      "id": "netease-cloudmusic-cache",
      "name": "网易云音乐缓存",
      "action": "delete",
      "category": "应用",
      "paths": ["%LOCALAPPDATA%/NetEase/CloudMusic/Cache", "%LOCALAPPDATA%/NetEase/CloudMusic/webapp*/Cache"],
      "risk": "low",
      "processes": ["cloudmusic"],
      "advice": "在网易云音乐的设置（下载设置）里清除缓存，并可以限制缓存大小、把缓存目录改到其他盘。已下载的歌曲不受影响。"
    },
    {
      "id": "vscode-cache",
      "name": "VS Code 缓存",
      "action": "delete",
      "category": "应用",
      "paths": [
        "%APPDATA%/Code/CachedExtensionVSIXs",
        "%APPDATA%/Code/CachedData",
        "%APPDATA%/Code/logs",
        "%APPDATA%/Code/Crashpad"
      ],
      "risk": "low",
      "processes": ["Code"],
      "advice": "关闭 VS Code 后删除这些目录。里面是扩展安装包、旧版本的编译缓存和日志，不影响设置和已装的扩展。"
    },
    {
      "id": "adobe-media-cache",
      "name": "Adobe 媒体缓存",
      "action": "delete",
      "category": "应用",
      "paths": [
        "%APPDATA%/Adobe/Common/Media Cache Files",
        "%APPDATA%/Adobe/Common/Media Cache",
        "%APPDATA%/Adobe/Common/Peak Files"
      ],
      "risk": "low",
      "minAgeDays": 7,
      "processes": ["Adobe Premiere Pro", "AfterFX", "Adobe Media Encoder", "Adobe Audition"],
      "advice": "Premiere Pro、After Effects、Media Encoder 为导入的素材生成的音频和预览缓存（.cfa、.pek），删除后打开工程时会自动重新生成。只清理 7 天前的。也可以在 Premiere 的 首选项 → 媒体缓存 里清理，或把缓存位置改到其他盘。"
    },
    {
      "id": "reasonlabs-data",
      "name": "RAV / ReasonLabs 安全软件的数据",
      "category": "应用",
      "paths": [
        "%ProgramData%/ReasonSaferWebService",
        "%ProgramData%/ReasonLabs",
        "%APPDATA%/ReasonLabs",
        "%LOCALAPPDATA%/ReasonLabs"
      ],
      "risk": "medium",
      "advice": "RAV Endpoint Protection、Safer Web 等 ReasonLabs 软件的数据和日志，其中 Errors.dat 可能涨到好几 GB。这类软件常被其他软件的安装程序捆绑装上：如果不是你主动安装的，可以在 设置 → 应用 里卸载，这些文件会一起删除。还在用的话不要手动删除。"
    },

    // ───────────── 国内常用软件 ─────────────
    // 只清理软件自己的网页缓存、日志和更新安装包。聊天记录、收到的文件、小程序数据一律不碰，
    // 它们归后面“聊天软件”一节的规则（仅供参考）。这些规则要放在宽泛的 electron-web-cache 前面。
    {
      "id": "wechat-web-cache",
      "name": "微信内置浏览器缓存",
      "action": "delete",
      "category": "国内软件",
      "paths": ["%APPDATA%/Tencent/xwechat/radium/web/profiles/*/Cache"],
      "risk": "low",
      "processes": ["Weixin", "WeChat", "WeChatAppEx"],
      "advice": "微信 4.0 里打开公众号文章、网页时的缓存，删除后会自动重建，不影响聊天记录和收到的文件。微信（包括后台的 WeChatAppEx）运行时跳过。"
    },
    {
      "id": "wechat-logs",
      "name": "微信日志",
      "action": "delete",
      "category": "国内软件",
      "paths": ["%APPDATA%/Tencent/xwechat/log", "%APPDATA%/Tencent/WeChat/log"],
      "risk": "low",
      "minAgeDays": 7,
      "processes": ["Weixin", "WeChat", "WeChatAppEx"],
      "advice": "微信的运行日志（.xlog），只用于排查问题。只清理 7 天前的。"
    },
    {
      "id": "wechat-update",
      "name": "微信更新安装包",
      "action": "quarantine",
      "category": "国内软件",
      "paths": ["%APPDATA%/Tencent/xwechat/update"],
      "risk": "medium",
      "processes": ["Weixin", "WeChat", "WeChatAppEx"],
      "advice": "微信自动下载的新版本安装包，可能还没有安装。删除后微信会在需要时重新下载。"
    },
    {
      "id": "qq-cache",
      "name": "QQ 缓存和日志",
      "action": "delete",
      "category": "国内软件",
      "paths": [
        "%APPDATA%/QQ/Cache",
        "%APPDATA%/QQ/Code Cache",
        "%APPDATA%/QQ/GPUCache",
        "%APPDATA%/QQ/log",
        "%APPDATA%/QQ/Partitions/*/Cache",
        "%APPDATA%/QQ/Partitions/*/Code Cache",
        "%APPDATA%/QQ/Partitions/*/GPUCache"
      ],
      "risk": "low",
      "minAgeDays": 3,
      "processes": ["QQ"],
      "advice": "新版 QQ（QQNT）界面的网页缓存和运行日志，不包含聊天记录（聊天记录在“文档\\Tencent Files”里）。只清理 3 天前的。"
    },
    {
      "id": "wegame-cache",
      "name": "WeGame 内置浏览器缓存",
      "action": "delete",
      "category": "国内软件",
      "paths": ["%APPDATA%/Tencent/WeGame/qbcore*/cache"],
      "risk": "low",
      "processes": ["wegame"],
      "advice": "WeGame 里商店、社区页面的网页缓存，删除后会自动重建，不影响游戏和存档。"
    },
    {
      "id": "androws-cache",
      "name": "腾讯应用宝缓存",
      "action": "delete",
      "category": "国内软件",
      "paths": [
        "%APPDATA%/Tencent/Androws/cef/*/Cache",
        "%APPDATA%/Tencent/Androws/cef/*/Code Cache",
        "%APPDATA%/Tencent/Androws/cef/*/GPUCache"
      ],
      "risk": "low",
      "processes": ["AndrowsStore", "AndrowsAssistant"],
      "advice": "腾讯应用宝（在电脑上运行安卓应用）里网页的缓存，删除后会自动重建，不影响已经安装的安卓应用。"
    },
    {
      "id": "baidunetdisk-cache",
      "name": "百度网盘缓存",
      "action": "delete",
      "category": "国内软件",
      "paths": ["%APPDATA%/baidunetdisk/Cache", "%APPDATA%/baidunetdisk/Code Cache", "%APPDATA%/baidunetdisk/GPUCache"],
      "risk": "low",
      "processes": ["BaiduNetdisk"],
      "advice": "百度网盘客户端界面的网页缓存，删除后会自动重建，不影响已经下载的文件。"
    },
    {
      "id": "quark-drive-cache",
      "name": "夸克网盘缓存",
      "action": "delete",
      "category": "国内软件",
      "paths": [
        "%LOCALAPPDATA%/QuarkCloudDrive/User Data/*/Cache",
        "%LOCALAPPDATA%/QuarkCloudDrive/User Data/*/Code Cache",
        "%LOCALAPPDATA%/QuarkCloudDrive/User Data/*/GPUCache",
        "%LOCALAPPDATA%/QuarkCloudDrive/User Data/GrShaderCache"
      ],
      "risk": "low",
      "processes": ["quark_cloud_drive"],
      "advice": "夸克网盘客户端的网页缓存，删除后会自动重建，不影响已经下载的文件。"
    },
    {
      "id": "coze-cache",
      "name": "扣子（Coze）缓存和日志",
      "action": "delete",
      "category": "国内软件",
      "paths": ["%APPDATA%/Coze/Cache", "%APPDATA%/Coze/Code Cache", "%APPDATA%/Coze/GPUCache", "%APPDATA%/Coze/logs"],
      "risk": "low",
      "minAgeDays": 3,
      "processes": ["Coze"],
      "advice": "扣子桌面版的网页缓存和运行日志，删除后会自动重建。只清理 3 天前的。"
    },
    {
      "id": "netease-cloudmusic-update",
      "name": "网易云音乐更新安装包",
      "action": "quarantine",
      "category": "国内软件",
      "paths": ["%LOCALAPPDATA%/NetEase/CloudMusic/update"],
      "risk": "medium",
      "processes": ["cloudmusic"],
      "advice": "网易云音乐自动下载的新版本安装包（orpheus_install.exe），可能还没有安装。删除后需要时会重新下载。"
    },
    {
      "id": "jianying-drafts",
      "name": "剪映草稿",
      "category": "国内软件",
      "paths": ["%LOCALAPPDATA%/JianyingPro/User Data/Projects"],
      "risk": "high",
      "processes": ["JianyingPro"],
      "advice": "剪映的草稿（包括导入素材的副本），删除后草稿就没了。草稿太大时，可以在剪映的“全局设置 → 草稿位置”里改到其他盘。"
    },
    {
      "id": "wps-cloud-files",
      "name": "WPS 云文档和备份",
      "category": "办公",
      "paths": ["%USERPROFILE%/Documents/WPS Cloud Files", "%APPDATA%/kingsoft/office6/backup"],
      "risk": "high",
      "processes": ["wps", "et", "wpp"],
      "advice": "WPS 云文档的本地副本和自动备份的文档，可能有还没同步的内容。请在 WPS 的“备份中心”和云文档设置里管理。"
    },
    {
      "id": "mumu-shared-folder",
      "name": "MuMu 模拟器共享文件夹",
      "category": "用户文件",
      "paths": ["%USERPROFILE%/Documents/MuMu共享文件夹"],
      "risk": "high",
      "advice": "模拟器里的安卓应用和电脑之间共享的文件（截图、导出的文件……），请手动整理。"
    },
    {
      "id": "steam-htmlcache",
      "name": "Steam 网页缓存",
      "action": "delete",
      "category": "游戏",
      "paths": [
        "%LOCALAPPDATA%/Steam/htmlcache/*/Cache",
        "%LOCALAPPDATA%/Steam/htmlcache/*/Code Cache",
        "%LOCALAPPDATA%/Steam/htmlcache/*/GPUCache"
      ],
      "risk": "low",
      "processes": ["steam", "steamwebhelper"],
      "advice": "Steam 商店和社区页面的缓存，删除后会自动重建，不影响游戏和存档。需要先完全退出 Steam（包括托盘图标）。"
    },

    {
      "id": "electron-web-cache",
      "name": "桌面软件的网页缓存",
      "action": "quarantine",
