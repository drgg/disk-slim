<Window x:Class="DiskSlim.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DiskSlim.Desktop.Controls"
        xmlns:vm="clr-namespace:DiskSlim.Desktop.ViewModels"
        Title="DiskSlim 硬盘瘦身"
        Width="1180" Height="780" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid x:Name="Root" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：磁盘概况和操作 -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="20,14,20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DiskSlim 硬盘瘦身" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DriveTitle}" FontSize="14" Foreground="{StaticResource SubtleTextBrush}" Margin="14,0,0,0" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Text="{Binding DriveDetail}" Foreground="{StaticResource SubtleTextBrush}" Margin="0,6,0,8" />
                    <ProgressBar Style="{StaticResource UsageBar}" Width="460" HorizontalAlignment="Left"
                                 Value="{Binding UsedRatio, Mode=OneWay}"
                                 Foreground="{Binding UsedRatio, Converter={StaticResource UsageBrush}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="Label"
                              MinWidth="240" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0"
                              IsEnabled="{Binding IsIdle}" ToolTip="选择要分析的磁盘" />
                    <Button Content="重新扫描" Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                    <Button Content="以管理员身份运行" Command="{Binding RestartAsAdminCommand}"
                            ToolTip="可以统计和清理更多系统目录（例如 C:\Windows\Temp）"
                            Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="Tabs">

            <!-- ───── 可清理项目 ───── -->
            <TabItem Header="可清理项目">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14,20,4">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RuleGroupViewModel}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Border Background="{Binding Risk, Converter={StaticResource RiskBrush}, ConverterParameter=soft}" CornerRadius="7,7,0,0" Padding="14,10">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                 Fill="{Binding Risk, Converter={StaticResource RiskBrush}}" />
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" />
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource SubtleTextBrush}" Margin="12,1,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:RuleItemViewModel}">
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}"
                                                                          VerticalAlignment="Top" Margin="0,3,12,0" ToolTip="{Binding ActionText}" />
                                                                <StackPanel Grid.Column="1">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                                        <Border Background="{StaticResource ChipBrush}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ActionText}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0" />
                                                                    <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"
                                                                               Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Margin="20,0,0,0" MinWidth="150">
                                                                    <TextBlock Text="{Binding SizeText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                                    <TextBlock Text="{Binding DetailText}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 底部操作栏 -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="清理选中项…" Padding="22,8"
                                    Command="{Binding CleanCommand}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectionText}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="清理前会先模拟并列出要处理的内容，确认后才会执行。“需要确认”的项目要手动勾选，“仅供参考”的项目不能清理。"
                                           Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ───── 空间分布 ───── -->
            <TabItem Header="空间分布">
                <Grid Margin="20,14,20,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 路径导航 -->
                    <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Left" Content="↑ 上一级" Command="{Binding NavigateUpCommand}" Margin="0,0,10,0" />
                        <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BreadcrumbItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource LinkButton}" Content="{Binding Name}"
                                                Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Node}" />
                                        <TextBlock Text="›" Foreground="{StaticResource SubtleTextBrush}" Margin="2,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsLast, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <!-- 方块图 -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1" ClipToBounds="True">
                        <controls:TreemapControl x:Name="Treemap" Node="{Binding MapCurrent}" Index="{Binding Index}">
                            <controls:TreemapControl.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="在资源管理器中显示" Click="OnTreemapShowInExplorer" />
                                </ContextMenu>
                            </controls:TreemapControl.ContextMenu>
                        </controls:TreemapControl>
                    </Border>

                    <!-- 悬停说明和图例 -->
                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                            <Rectangle Width="12" Height="12" Fill="#8FB3DE" Margin="0,0,4,0" />
                            <TextBlock Text="普通文件夹" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,12,0" />
                            <Rectangle Width="12" Height="12" Fill="#6CC070" Margin="0,0,4,0" />
                            <TextBlock Text="可放心清理" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,12,0" />
                            <Rectangle Width="12" Height="12" Fill="#FFC940" Margin="0,0,4,0" />
                            <TextBlock Text="需要确认" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,12,0" />
                            <Rectangle Width="12" Height="12" Fill="#F0A0A0" Margin="0,0,4,0" />
                            <TextBlock Text="仅供参考" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,12,0" />
                            <Rectangle Width="16" Height="3" Fill="#2E7D32" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="其中可清理的比例" Foreground="{StaticResource SubtleTextBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding HoverText}" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <!-- 右侧：当前目录的子项 -->
                    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="14,12,14,8">
                                <TextBlock Text="{Binding CurrentTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentTitle}" />
                                <TextBlock Text="{Binding CurrentDetail}" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <ListBox x:Name="ChildrenList" ItemsSource="{Binding CurrentChildren}" BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource PlainListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="OnChildDoubleClick">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="打开" Click="OnChildOpen" />
                                        <MenuItem Header="在资源管理器中显示" Click="OnChildShowInExplorer" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FolderItemViewModel}">
                                        <Grid Margin="14,6" ToolTip="{Binding Path}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource UsageBar}" Height="4" Margin="0,4,0,0"
                                                         Value="{Binding Ratio, Mode=OneWay}" Foreground="#8FB3DE" />
                                            <TextBlock Grid.Row="2" Text="{Binding CleanableText}" FontSize="11" Foreground="#2E7D32" Margin="0,3,0,0"
                                                       Visibility="{Binding HasCleanable, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RatioText}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,3,0,0" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ───── 最大的文件 ───── -->
            <TabItem Header="最大的文件">
                <Border Style="{StaticResource Card}" Margin="20,14">
                    <ListView x:Name="LargestFilesList" ItemsSource="{Binding LargestFiles}" BorderThickness="0" Margin="4">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="在资源管理器中显示" Click="OnLargeFileShowInExplorer" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="大小" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:LargeFileViewModel}">
                                            <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="修改日期" Width="100" DisplayMemberBinding="{Binding DateText}" />
                                <GridViewColumn Header="文件名" Width="300" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="所在位置" Width="560" DisplayMemberBinding="{Binding Folder}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </TabItem>
            <!-- ───── 重复文件 ───── -->
            <TabItem Header="重复文件" DataContext="{Binding Duplicates}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="20,14,20,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="不小于" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource SubtleTextBrush}" />
                                <ComboBox ItemsSource="{Binding MinSizes}" SelectedItem="{Binding MinSize}" DisplayMemberPath="Label" Width="90" Height="32" VerticalContentAlignment="Center" />
                                <Button Content="开始查找" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" Margin="8,0,0,0" />
                                <Button Content="取消" Command="{Binding CancelCommand}" Margin="8,0,0,0"
                                        Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock Text="查找位置" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource SubtleTextBrush}" />
                            <Button DockPanel.Dock="Right" Content="浏览…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="6,0" />
                        </DockPanel>
                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBlock Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="不查软件数据（AppData、ProgramData）和开发工具目录（.git、node_modules……）。默认只勾选明显的副本（文件名带“(1)”“副本”，或在下载文件夹里）；其他重复文件可能被项目或软件引用，请自己判断。勾选的文件会移入隔离区，可以恢复。" />
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,4" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource SubtleTextBrush}" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,8">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DuplicateGroupViewModel}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Note}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,2,0,0"
                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                            <ItemsControl ItemsSource="{Binding Files}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:DuplicateFileViewModel}">
                                                        <Grid Margin="0,3" ToolTip="{Binding Path}">
                                                            <Grid.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="在资源管理器中显示" Click="OnDuplicateShowInExplorer" />
                                                                </ContextMenu>
                                                            </Grid.ContextMenu>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,2,8,0"
                                                                      ToolTip="勾选 = 移入隔离区" />
                                                            <Border Grid.Column="1" Background="{StaticResource ChipBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Top"
                                                                    Visibility="{Binding HasTag, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="{Binding Tag}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                                                            </Border>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{StaticResource WarningBrush}"
                                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="3" Text="{Binding DateText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="12,0,0,0" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="只勾选明显的副本" Command="{Binding SelectSuggestedCommand}" Margin="0,0,8,0" />
                                <Button Content="全部取消" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" />
                                <Button Content="移入隔离区…" Style="{StaticResource DangerButton}" Command="{Binding RemoveCommand}" Padding="18,8" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectionText}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Message}" Foreground="#2E7D32" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ───── 系统清理 ───── -->
            <TabItem Header="系统清理" DataContext="{Binding SystemTasks}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14">
                    <StackPanel>
                        <TextBlock Text="这些清理需要管理员权限，由 Windows 自带的工具完成（DISM、powercfg 等）。只能运行下面列出的固定任务。" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ElevationNote}" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SystemTaskItemViewModel}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding EstimateText}" Margin="12,1,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSizeEstimate}" Value="True">
                                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding Warning}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding UndoHint}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,4,0,0"
                                                           Visibility="{Binding HasUndoHint, Converter={StaticResource BoolToVisibility}}" />
                                                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="运行…" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" Margin="16,0,0,0" MinWidth="80"
                                                    Command="{Binding DataContext.RunTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding NotNeeded, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ───── 隔离区 ───── -->
            <TabItem Header="隔离区" DataContext="{Binding Quarantine}">
                <Grid Margin="20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="“需要确认”的项目清理时会先移到这里：随时可以恢复原位，确认没问题后再彻底删除。超过 7 天的内容会作为“可放心清理”的项目出现在清理列表里。" />
                            <TextBlock Text="{Binding Message}" Foreground="#2E7D32" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <Grid>
                            <TextBlock Text="还没有移入隔离区的文件。清理“需要确认”的项目后，它们会出现在这里。" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Sessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:QuarantineSessionViewModel}">
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DetailText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding Id}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="恢复" Margin="0,0,8,0" ToolTip="把这一批文件放回原来的位置（不会覆盖已有文件）"
                                                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="彻底删除" Style="{StaticResource DangerButton}" ToolTip="删除后无法恢复，会释放空间"
                                                                Command="{Binding DataContext.PurgeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 扫描中遮罩 -->
        <Border Grid.Row="1" Background="#E6F4F6F9" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Width="480" Padding="24,20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="正在扫描…" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,10" />
                    <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                    <TextBlock Text="只读取文件信息，不会修改任何文件。" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <Button Content="取消" Command="{Binding CancelScanCommand}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,6">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
