<Window x:Class="DiskSlim.Desktop.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiskSlim.Desktop.ViewModels"
        Title="清理"
        Width="760" Height="580" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid x:Name="Root" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,18">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="14" />
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,6"
                             Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,6,22,6">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CleanupItemViewModel}">
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Margin="0,5,12,0" VerticalAlignment="Top"
                                         Fill="{Binding Kind, Converter={StaticResource OutcomeBrush}}" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RiskText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="8,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,3,0,0"
                                               Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="330" TextAlignment="Right" Margin="16,0,0,0"
                                           Foreground="{Binding Kind, Converter={StaticResource OutcomeBrush}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="打开日志所在文件夹" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0"
                            Visibility="{Binding HasLog, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" MinWidth="80" Margin="0,0,8,0" />
                    <Button Content="开始清理" Style="{StaticResource DangerButton}" Command="{Binding StartCommand}" MinWidth="100"
                            Visibility="{Binding IsConfirm, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Text="{Binding FooterText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
